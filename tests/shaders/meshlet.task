#version 460
#extension GL_EXT_mesh_shader : require
#extension GL_EXT_nonuniform_qualifier : require

// Task (amplification) shader: cluster-level culling per Plan §5.3.
// Each invocation tests one meshlet (frustum sphere + backface cone, meshopt
// bounds convention); visible meshlets are compacted into the task payload
// and emitted as mesh shader workgroups.

layout(local_size_x = 32) in;

layout(set = 0, binding = 0) uniform FrameUBO {
    mat4 view;
    mat4 proj;
    vec3 light_dir;
    float pad0;
    vec3 camera_pos;
    float pad1;
    vec4 frustum_planes[6]; // (n, d): inside when n.p + d >= 0
} ubo;

// All meshlet data buffers are uint arrays in the global buffer table (§5.3).
// Writable: the optional stats buffer lives here too.
layout(set = 0, binding = 1) buffer DataBuf { uint data[]; } buffers[];
layout(set = 0, binding = 2) uniform sampler2D textures[];

layout(push_constant) uniform Push {
    mat4 model;
    uint texture_index;
    uint meshlet_count;
    uint meshlet_buf;
    uint vertex_buf;
    uint vidx_buf;
    uint tidx_buf;
    uint hiz_tex;   // texture table index of the Hi-Z pyramid, 0xFFFFFFFF = off
    uint stats_buf; // buffer table index of {tested, emitted} counters, off if ~0
    uint lod_buf;   // LOD DAG info buffer {group_error, parent_error, level, pad}, ~0 = off
    float lod_threshold;  // screen-space error threshold in pixels
    float lod_px_factor;  // abs(proj[0][0]) * screen_w * 0.5
} push;

taskPayloadSharedEXT struct Payload {
    uint meshlet_indices[32];
} payload;

shared uint s_visible_count;

// GpuMeshlet field offsets in uints (64-byte descriptor, meshlet.hpp).
vec3 read_vec3(uint base, uint o) {
    const uint b = nonuniformEXT(push.meshlet_buf);
    return vec3(uintBitsToFloat(buffers[b].data[base + o]),
                uintBitsToFloat(buffers[b].data[base + o + 1]),
                uintBitsToFloat(buffers[b].data[base + o + 2]));
}

void main() {
    if (gl_LocalInvocationIndex == 0) {
        s_visible_count = 0;
    }
    barrier();

    const uint gid = gl_GlobalInvocationID.x;
    bool visible = false;
    if (gid < push.meshlet_count) {
        const uint base = gid * 16; // 16 uints per GpuMeshlet
        const vec3 center = read_vec3(base, 4);
        const uint b = nonuniformEXT(push.meshlet_buf);
        const float radius = uintBitsToFloat(buffers[b].data[base + 7]);
        const vec3 cone_axis = read_vec3(base, 12);
        const float cone_cutoff = uintBitsToFloat(buffers[b].data[base + 11]);

        // World-space bounds (uniform scale + translate; cone axis is
        // rotation-invariant here — full transform lands with §7.2).
        const vec3 wcenter = (push.model * vec4(center, 1.0)).xyz;
        const float wradius = radius * length(push.model[0].xyz);

        // Frustum sphere test (world space).
        visible = true;
        for (int i = 0; i < 6; ++i) {
            if (dot(ubo.frustum_planes[i].xyz, wcenter) + ubo.frustum_planes[i].w < -wradius) {
                visible = false;
                break;
            }
        }
        // Backface cone test (meshoptimizer convention).
        if (visible && cone_cutoff < 1.0) {
            const vec3 dir = wcenter - ubo.camera_pos;
            if (dot(dir, cone_axis) >= cone_cutoff * length(dir) + wradius) {
                visible = false;
            }
        }
        // LOD DAG cut (§7.2): render this cluster when its group error
        // projects to <= threshold pixels but its parent group's error does
        // not. Parent of root clusters is FLT_MAX, so roots always qualify
        // when coarse enough.
        if (visible && push.lod_buf != 0xFFFFFFFFu) {
            const uint lb = nonuniformEXT(push.lod_buf);
            const float group_error = uintBitsToFloat(buffers[lb].data[gid * 4 + 0]);
            const float parent_error = uintBitsToFloat(buffers[lb].data[gid * 4 + 1]);
            const float cdist = max(-(ubo.view * vec4(wcenter, 1.0)).z, 1e-4);
            const float err_px = group_error * push.lod_px_factor / cdist;
            const float perr_px = parent_error * push.lod_px_factor / cdist;
            if (err_px > push.lod_threshold || perr_px <= push.lod_threshold) {
                visible = false;
            }
        }
        // Hi-Z occlusion test (§5.3): project the cluster sphere to a screen
        // rect, sample the pyramid at the covering mip, cull if the cluster's
        // nearest possible depth is still behind the closest occluder there.
        if (visible && push.hiz_tex != 0xFFFFFFFFu) {
            const vec3 center_view = (ubo.view * vec4(wcenter, 1.0)).xyz;
            const float dist = max(-center_view.z, 1e-4);
            const float z_near = max(dist - wradius, 1e-4);
            const vec4 cn = ubo.proj * vec4(0.0, 0.0, -z_near, 1.0);
            const float depth_near = cn.z / cn.w; // reverse-Z: larger = nearer
            const vec4 cc = ubo.proj * vec4(center_view, 1.0);
            const vec2 center_ndc = cc.xy / cc.w;
            // abs(): proj[1][1] is negative (baked Vulkan Y-flip).
            const vec2 half_ndc =
                vec2(wradius * abs(ubo.proj[0][0]), wradius * abs(ubo.proj[1][1])) / dist;
            // Rect in mip0 texels (half_ndc = 1.0 is half the screen, i.e.
            // mip0_width texels). Smallest mip whose texel covers the rect:
            // mip i texel = 2^i mip0 texels, so lod = ceil(log2(rect)).
            const vec2 mip0_px = vec2(textureSize(textures[nonuniformEXT(push.hiz_tex)], 0));
            const vec2 rect_px = half_ndc * mip0_px;
            const float lod = ceil(log2(max(max(rect_px.x, rect_px.y), 1.0)));
            const float occ = textureLod(textures[nonuniformEXT(push.hiz_tex)],
                                         center_ndc * 0.5 + 0.5, lod).r;
            if (depth_near < occ) {
                visible = false;
            }
        }
    }
    if (push.stats_buf != 0xFFFFFFFFu && gid < push.meshlet_count) {
        atomicAdd(buffers[nonuniformEXT(push.stats_buf)].data[0], 1u); // tested
        if (visible) {
            atomicAdd(buffers[nonuniformEXT(push.stats_buf)].data[1], 1u); // emitted
        }
    }

    if (visible) {
        const uint slot = atomicAdd(s_visible_count, 1);
        payload.meshlet_indices[slot] = gid;
    }
    barrier();
    EmitMeshTasksEXT(s_visible_count, 1, 1);
}
