#version 460
#extension GL_EXT_nonuniform_qualifier : require

// Clustered light assignment (Plan §5.2): one invocation per point light.
// Projects the light sphere to a screen-tile AABB + log-z slice range of the
// 16x9x24 froxel grid and appends the light index to every covered cluster's
// list. Cluster list layout in the uint-array buffer: 65 uints per cluster —
// [count, light_idx0 .. light_idx63].

layout(local_size_x = 64) in;

layout(set = 0, binding = 0) uniform FrameUBO {
    mat4 view;
    mat4 proj;
    vec3 light_dir;
    float pad0;
    vec3 camera_pos;
    float pad1;
    vec4 frustum_planes[6];
    mat4 inv_view_proj;
} ubo;

layout(set = 0, binding = 1) buffer DataBuf { uint data[]; } buffers[];

layout(push_constant) uniform Push {
    uint lights_buf;  // 8 uints per light: pos xyz, radius, color rgb, pad
    uint cluster_buf; // 65 uints per cluster
    uint light_count;
    uint pad;
} push;

const ivec3 grid = ivec3(16, 9, 24);
const float z_far = 30.0;

float buf_float(uint buf, uint i) {
    return uintBitsToFloat(buffers[nonuniformEXT(buf)].data[i]);
}

void main() {
    const uint li = gl_GlobalInvocationID.x;
    if (li >= push.light_count) {
        return;
    }

    const uint lb = nonuniformEXT(push.lights_buf);
    const vec3 light_pos = vec3(buf_float(lb, li * 8), buf_float(lb, li * 8 + 1),
                                buf_float(lb, li * 8 + 2));
    const float radius = buf_float(lb, li * 8 + 3);

    const float z_near = ubo.proj[3][2];
    const vec3 lv = (ubo.view * vec4(light_pos, 1.0)).xyz;
    const float dist = -lv.z;
    if (dist + radius < z_near || dist - radius > z_far) {
        return;
    }

    // Screen-space AABB of the light sphere; full range when the sphere
    // straddles the camera plane.
    vec2 lo = vec2(-1.0);
    vec2 hi = vec2(1.0);
    if (dist >= z_near) {
        const vec4 cc = ubo.proj * vec4(lv, 1.0);
        const vec2 cndc = cc.xy / cc.w;
        const float d = max(dist, 1e-4);
        // abs(): proj[1][1] is negative (baked Vulkan Y-flip).
        const vec2 half_ndc =
            vec2(radius * abs(ubo.proj[0][0]), radius * abs(ubo.proj[1][1])) / d;
        lo = clamp(cndc - half_ndc, vec2(-1.0), vec2(1.0));
        hi = clamp(cndc + half_ndc, vec2(-1.0), vec2(1.0));
    }

    ivec2 t0 = clamp(ivec2((lo * 0.5 + 0.5) * vec2(grid.xy)), ivec2(0), grid.xy - 1);
    ivec2 t1 = clamp(ivec2((hi * 0.5 + 0.5) * vec2(grid.xy)), ivec2(0), grid.xy - 1);

    const float z0 = max(dist - radius, z_near);
    const float z1 = min(dist + radius, z_far);
    const float inv_log_range = 1.0 / log(z_far / z_near);
    const int s0 = clamp(int(floor(log(z0 / z_near) * inv_log_range * float(grid.z))), 0,
                         grid.z - 1);
    const int s1 = clamp(int(floor(log(z1 / z_near) * inv_log_range * float(grid.z))), 0,
                         grid.z - 1);

    const uint cb = nonuniformEXT(push.cluster_buf);
    for (int s = s0; s <= s1; ++s) {
        for (int ty = t0.y; ty <= t1.y; ++ty) {
            for (int tx = t0.x; tx <= t1.x; ++tx) {
                const uint ci = (uint(s) * uint(grid.y) + uint(ty)) * uint(grid.x) + uint(tx);
                const uint base = ci * 65u;
                const uint slot = atomicAdd(buffers[cb].data[base], 1u);
                if (slot < 64u) {
                    buffers[cb].data[base + 1u + slot] = li;
                }
            }
        }
    }
}
