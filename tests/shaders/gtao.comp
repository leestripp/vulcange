#version 460
#extension GL_EXT_nonuniform_qualifier : require

// Horizon-based ambient occlusion (Plan §6.3, GTAO-lite: single frame, plain
// depth march — Hi-Z acceleration and temporal accumulation land with TAA).
// Half resolution. For each azimuth direction the shader marches the depth
// buffer to find the highest horizon elevation above the slice-plane tangent
// and occludes against the G-Buffer normal's elevation along that tangent.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform FrameUBO {
    mat4 view;
    mat4 proj;
    vec3 light_dir;
    float pad0;
    vec3 camera_pos;
    float pad1;
    vec4 frustum_planes[6];
    mat4 inv_view_proj;
} ubo;

layout(set = 0, binding = 2) uniform sampler2D textures[];
layout(set = 0, binding = 3, r8) writeonly uniform image2D storage_images[];

layout(push_constant) uniform Push {
    uint depth_tex;
    uint normal_tex;
    uint ao_img;
    uint full_w;
    uint full_h;
    float radius;
    float strength;
    uint pad;
} push;

const int kDirs = 4;
const int kSteps = 6;

// Analytic view-space reconstruction (infinite reverse-Z: dist = z_near/z).
vec3 view_pos(uint px_x, uint px_y, float depth) {
    const vec2 ndc = (vec2(float(px_x) + 0.5, float(px_y) + 0.5) /
                      vec2(float(push.full_w), float(push.full_h))) * 2.0 - 1.0;
    const float dist = ubo.proj[3][2] / max(depth, 1e-6);
    return vec3(ndc.x * dist / ubo.proj[0][0], ndc.y * dist / ubo.proj[1][1], -dist);
}

float hash12(vec2 p) {
    const vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    return fract(dot(p3, p3.yzx + 33.33));
}

void main() {
    const ivec2 half_px = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 full_px = min(half_px * 2 + 1, ivec2(int(push.full_w) - 1, int(push.full_h) - 1));

    const float depth = texelFetch(textures[nonuniformEXT(push.depth_tex)], full_px, 0).r;
    float ao = 1.0;
    if (depth > 1e-6) { // reverse-Z: 0 = far plane / background
        const vec3 P = view_pos(uint(full_px.x), uint(full_px.y), depth);
        const vec3 V = normalize(-P);
        const vec4 packed_n = texelFetch(textures[nonuniformEXT(push.normal_tex)], full_px, 0);
        const vec3 N = mat3(ubo.view) * normalize(packed_n.xyz * 2.0 - 1.0);

        const float dist = -P.z;
        // View-space radius -> pixel stride (approximate, x-axis projection).
        const float px_radius =
            max(push.radius * abs(ubo.proj[0][0]) / dist * float(push.full_w) * 0.5, 1.5);
        const float stride = px_radius / float(kSteps);
        const float jitter = hash12(vec2(half_px));

        float occ_sum = 0.0;
        for (int d = 0; d < kDirs; ++d) {
            const float phi = (float(d) + jitter) * (3.14159265 / float(kDirs));
            const vec2 dir = vec2(cos(phi), sin(phi));
            const vec3 dir_view = vec3(dir, 0.0);
            const vec3 slice_n = normalize(cross(V, dir_view));
            const vec3 tangent = normalize(cross(slice_n, V)); // in the slice plane

            // Horizon elevation measured against the tangent plane at P
            // (dot(delta, N) — slice-independent): samples lying in P's own
            // surface score exactly zero, so flat planes never self-occlude.
            // Off-slice-line projection errors (the classic GTAO pitfall) do
            // not arise. The slice only attributes occluders to a side.
            float occ_plus = 0.0;
            float occ_minus = 0.0;
            for (int s = -kSteps; s <= kSteps; ++s) {
                if (s == 0) {
                    continue;
                }
                const vec2 suv = vec2(full_px) + dir * (float(s) * stride);
                if (suv.x < 0.0 || suv.y < 0.0 || suv.x >= float(push.full_w) ||
                    suv.y >= float(push.full_h)) {
                    continue;
                }
                const float sd = texelFetch(textures[nonuniformEXT(push.depth_tex)],
                                            ivec2(suv), 0).r;
                if (sd <= 1e-6) {
                    continue;
                }
                const vec3 S = view_pos(uint(suv.x), uint(suv.y), sd);
                const vec3 delta = S - P;
                const float len2 = dot(delta, delta);
                if (len2 > push.radius * push.radius * 4.0 || len2 < 1e-8) {
                    continue;
                }
                const vec3 dn = normalize(delta);
                const float elev = dot(dn, N); // elevation above the tangent plane
                if (dot(dn, tangent) > 0.0) {
                    occ_plus = max(occ_plus, elev);
                } else {
                    occ_minus = max(occ_minus, elev);
                }
            }
            occ_sum += clamp((max(occ_plus, 0.0) + max(occ_minus, 0.0)) * 0.5, 0.0, 1.0);
        }
        ao = clamp(1.0 - (occ_sum / float(kDirs)) * push.strength, 0.0, 1.0);
    }
    imageStore(storage_images[nonuniformEXT(push.ao_img)], half_px, vec4(ao, 0, 0, 0));
}
