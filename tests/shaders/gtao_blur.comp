#version 460
#extension GL_EXT_nonuniform_qualifier : require

// Depth-aware separable blur for the AO term (Plan §6.3 denoise; temporal
// accumulation replaces most of this once TAA lands). 5-tap bilateral:
// neighbours with large depth discontinuity are rejected.

layout(local_size_x = 8, local_size_y = 8) in;

layout(set = 0, binding = 0) uniform FrameUBO {
    mat4 view;
    mat4 proj;
    vec3 light_dir;
    float pad0;
    vec3 camera_pos;
    float pad1;
    vec4 frustum_planes[6];
    mat4 inv_view_proj;
} ubo;

layout(set = 0, binding = 2) uniform sampler2D textures[];
layout(set = 0, binding = 3, r8) writeonly uniform image2D storage_images[];

layout(push_constant) uniform Push {
    uint src_tex;   // AO source (half-res)
    uint depth_tex; // full-res depth for edge weights
    uint dst_img;
    uint axis;      // 0 = horizontal, 1 = vertical
    uint full_w;
    uint full_h;
    uint pad0;
    uint pad1;
} push;

void main() {
    const ivec2 half_px = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 full_px = min(half_px * 2 + 1, ivec2(int(push.full_w) - 1, int(push.full_h) - 1));
    const float center_depth =
        texelFetch(textures[nonuniformEXT(push.depth_tex)], full_px, 0).r;

    const ivec2 step = push.axis == 0u ? ivec2(1, 0) : ivec2(0, 1);
    const ivec2 half_size = ivec2(int(push.full_w) / 2, int(push.full_h) / 2);

    float sum = 0.0;
    float wsum = 0.0;
    for (int i = -2; i <= 2; ++i) {
        const ivec2 sp = clamp(half_px + step * i, ivec2(0), half_size - 1);
        const ivec2 sfull = min(sp * 2 + 1, ivec2(int(push.full_w) - 1, int(push.full_h) - 1));
        const float sd = texelFetch(textures[nonuniformEXT(push.depth_tex)], sfull, 0).r;
        // Bilateral weight: gaussian x edge stop on relative depth change.
        const float dw = abs(sd - center_depth) / max(center_depth, 1e-5);
        const float w = (i == 0 ? 1.0 : (i == -1 || i == 1 ? 0.6 : 0.3)) *
                        (dw < 0.05 ? 1.0 : 0.0);
        sum += texelFetch(textures[nonuniformEXT(push.src_tex)], sp, 0).r * w;
        wsum += w;
    }
    const float ao = wsum > 0.0 ? sum / wsum : 1.0;
    imageStore(storage_images[nonuniformEXT(push.dst_img)], half_px, vec4(ao, 0, 0, 0));
}
